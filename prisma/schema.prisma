generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Render's free web-service plan has no persistent disk — the local
// filesystem is wiped on every deploy/restart, so generated images are
// stored here instead of under OUTPUT_DIR. Keyed by the same relative path
// string ("outputs/images/<file>") that was previously used as a real file
// path; see src/lib/image-store.ts.
model ImageAsset {
  path        String   @id
  data        Bytes
  contentType String   @default("image/png")
  createdAt   DateTime @default(now())
}

model PosterTheme {
  id             String   @id @default(cuid())
  collection     String
  themeJa        String
  themeEn        String
  verticalTextJa String
  subtitleEn     String
  motif          String
  colorPalette   String
  stylePreset    String   @default("")
  status         String   @default("idea")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  generations PosterGeneration[]
}

model PosterGeneration {
  id                String   @id @default(cuid())
  themeId           String
  orientation       String   @default("portrait")
  prompt            String   @default("")
  imagePath         String   @default("")
  printImagePath    String   @default("")
  imageUrl          String   @default("")
  qualityScore      Int?
  qualityComment    String   @default("")
  etsyTitle         String   @default("")
  etsyDescription   String   @default("")
  etsyTags          String   @default("")
  pinterestCaption  String   @default("")
  instagramCaption  String   @default("")
  xCaption          String   @default("")
  status            String   @default("idea")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  theme PosterTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  mockups PosterMockup[]
}

// AI-generated "poster displayed in a real room" lifestyle photos for a
// PosterGeneration, used as Etsy/SNS listing photos. One row per fixed scene
// (see src/lib/poster-mockup.ts). Generated via openai.images.edit on the
// poster's own image — same technique as ReviewRound's lifestyle photos.
model PosterMockup {
  id           String   @id @default(cuid())
  generationId String
  scene        String
  label        String   @default("")
  imagePath    String   @default("")
  createdAt    DateTime @default(now())

  generation PosterGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, scene])
}

// --- Article pipeline (Medium <-> note original-article studio) ---

// RSS/Atom feeds polled for trends. Used for inspiration only, never reposted.
model FeedSource {
  id            String    @id @default(cuid())
  name          String
  feedUrl       String    @unique
  // "en2ja" (Medium EN -> note JA) or "ja2en" (note/JP -> Medium EN)
  direction     String
  category      String    @default("")
  active        Boolean   @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items ResearchItem[]
}

// A trend item collected from a feed. Inspiration source; body is NOT stored.
model ResearchItem {
  id          String    @id @default(cuid())
  feedId      String?
  direction   String
  category    String    @default("")
  title       String
  url         String    @unique
  summary     String    @default("")
  author      String    @default("")
  publishedAt DateTime?
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  feed     FeedSource? @relation(fields: [feedId], references: [id], onDelete: SetNull)
  articles Article[]
}

// A generated ORIGINAL draft. Never a copy/translation of a source article.
model Article {
  id             String   @id @default(cuid())
  researchItemId String?
  direction      String
  // Only set when direction = "note" (the generic multi-genre channel).
  // Key of a preset in src/lib/genres.ts, e.g. "sleep", "kakei", "work".
  genre          String   @default("")
  category       String   @default("")
  // Output language: "ja" (note) or "en" (medium)
  language       String
  targetPlatform String   @default("")
  topic          String   @default("")
  title          String   @default("")
  subtitle       String   @default("")
  body           String   @default("")
  // Body as first generated, kept when humanize passes rewrite `body` so the
  // original is never lost (see src/lib/humanize.ts).
  rawBody        String   @default("")
  // Comma-separated labels of the humanize passes applied so far.
  humanizeLog    String   @default("")
  tags           String   @default("")
  model          String   @default("")
  status         String   @default("generated")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  researchItem ResearchItem? @relation(fields: [researchItemId], references: [id], onDelete: SetNull)
  videos       VideoProject[]
}

// --- Article -> YouTube video studio ---
// Turns a reviewed article draft (or a bare topic) into everything needed to
// publish a YouTube video: a narration script split into scenes, one AI image
// per scene, TTS narration audio, SRT captions, and the listing metadata
// (title / description / tags / chapters). The final MP4/WebM is assembled in
// the BROWSER at /videos/[id]/studio — Render's free plan has no ffmpeg and
// only 512MB, so encoding server-side is not an option.
// Uploading to YouTube stays manual and human-reviewed, like every other
// pipeline in this app.
model VideoProject {
  id           String   @id @default(cuid())
  articleId    String?
  // "long" (16:9 narrated explainer) or "short" (9:16 vertical, under 60s)
  format       String   @default("long")
  // Key of a preset in src/lib/video-style.ts, e.g. "japandi", "aizuri"
  visualStyle  String   @default("japandi")
  // OpenAI TTS voice id used for narration
  voice        String   @default("alloy")
  genre        String   @default("")
  topic        String   @default("")
  // YouTube listing metadata
  title        String   @default("")
  description  String   @default("")
  tags         String   @default("")
  hook         String   @default("")
  chapters     String   @default("")
  thumbnailText   String @default("")
  thumbnailPrompt String @default("")
  thumbnailPath   String @default("")
  model        String   @default("")
  // "planned" -> "images" -> "narrated" -> "ready" -> "published" / "rejected"
  status       String   @default("planned")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  article Article?    @relation(fields: [articleId], references: [id], onDelete: SetNull)
  scenes  VideoScene[]
}

// One scene of a VideoProject: a chunk of narration plus the still image and
// audio rendered for it. `index` is the playback order.
model VideoScene {
  id           String   @id @default(cuid())
  projectId    String
  index        Int
  heading      String   @default("")
  narration    String   @default("")
  onScreenText String   @default("")
  imagePrompt  String   @default("")
  imagePath    String   @default("")
  audioPath    String   @default("")
  // Measured duration of the narration audio; 0 until narration is generated.
  audioSeconds Float    @default(0)
  // Planned duration, used when there is no narration audio.
  seconds      Int      @default(6)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, index])
}

// --- Rakuten affiliate review studio ---
// One tracked Rakuten product at a time accumulates weekly "review rounds":
// 5 fixed reviewer-persona write-ups + one AI lifestyle photo per round.
// Builds a growing library of affiliate review content per product instead of
// generating many products at once. Publishing stays human-reviewed.

// A Rakuten Ichiba product being tracked for weekly review generation.
model RakutenProduct {
  id            String   @id @default(cuid())
  itemUrl       String   @unique
  itemCode      String   @default("")
  shopCode      String   @default("")
  shopName      String   @default("")
  name          String   @default("")
  price         Int      @default(0)
  imageUrl      String   @default("")
  catchcopy     String   @default("")
  itemCaption   String   @default("")
  genreName     String   @default("")
  reviewAverage Float    @default(0)
  reviewCount   Int      @default(0)
  affiliateUrl  String   @default("")
  // "active" (weekly cron keeps generating rounds) | "paused" | "archived"
  status        String   @default("active")
  weekCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rounds ReviewRound[]
}

// One weekly batch of reviews for a product: a shared AI lifestyle photo
// plus 5 persona reviews (see ReviewRound.reviews).
model ReviewRound {
  id         String   @id @default(cuid())
  productId  String
  weekNumber Int
  imagePath  String   @default("")
  // "generated" -> "review" -> "approved" / "rejected" -> "exported"
  status     String   @default("generated")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product RakutenProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviews ProductReview[]
}

// One reviewer-persona's write-up within a ReviewRound.
model ProductReview {
  id         String   @id @default(cuid())
  roundId    String
  persona    String
  personaJa  String   @default("")
  angle      String   @default("")
  title      String   @default("")
  body       String   @default("")
  rating     Int      @default(5)
  snsCaption String   @default("")
  status     String   @default("generated")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  round ReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

// --- Public blog ("茶と暮らしの手帖") ---
// Original, editorial buying-guide articles shown at /blog with no admin
// controls — the public-facing site content required to register for
// affiliate programs (e.g. Rakuten Affiliate) before an affiliate ID exists.
// Not the same as Article (note/Medium drafts) or ProductReview (persona
// reviews of one tracked product) — this is the site's own genuine content.
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  body        String
  category    String   @default("")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
